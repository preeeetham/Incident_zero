# Incident Zero secrets. Copy to .env (git-ignored) and edit.
# Only the model and the mail server live here; everything else is in incident_zero.yaml (or IZ_<KEY> variables,
# e.g. IZ_LLM_ENABLED=false to run fully deterministic). Precedence: process environment > this file > defaults.
# This file is read with a plain key=value parser: put comments on their own lines.

# ---------------------------------------------------------------- LLM
# Provider: ollama (local) | openai (any OpenAI-compatible chat API: OpenAI, Gemini, Groq, OpenRouter, ...)
# | anthropic. Without a reachable model every agent uses its deterministic path.
LLM_PROVIDER=

# Model name. Empty = provider default (ollama: phi4-mini, openai: gpt-4o-mini, anthropic: claude-sonnet-5).
LLM_MODEL=

# Base URL. Empty = provider default
# (ollama: http://127.0.0.1:11434, openai: https://api.openai.com/v1, anthropic: https://api.anthropic.com).
# Examples: Gemini https://generativelanguage.googleapis.com/v1beta/openai, Groq https://api.groq.com/openai/v1,
# OpenRouter https://openrouter.ai/api/v1
LLM_BASE_URL=

# API key for the openai / anthropic providers. Not needed for ollama.
LLM_API_KEY=

# Per-request timeout in seconds (at least 90 is used).
LLM_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------- approval email (optional)
# When set, the Approval Gate mails the plan to notify_email (incident_zero.yaml), or ADMIN_EMAIL if that is empty,
# and the Verifier mails escalations. The decision itself is always made in the Control Room or the CLI.
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# From header. Empty = SMTP_USER.
SMTP_FROM=
